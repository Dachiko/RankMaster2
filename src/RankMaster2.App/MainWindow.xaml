<Window x:Class="RankMaster2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rank Master 2"
        Background="#000000"
        Foreground="#E5E7EB"
        FontFamily="Segoe UI, sans-serif"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        KeyDown="OnKeyDown">
    <Grid>
        <!-- Start / idle — zinc-900 → black, same button stack as RankMaster -->
        <Grid x:Name="StartPanel">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#18181B" Offset="0"/>
                    <GradientStop Color="#000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="512">
                <TextBlock FontSize="48" FontWeight="Black" TextAlignment="Center" Margin="0,0,0,8">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#60A5FA" Offset="0"/>
                            <GradientStop Color="#34D399" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    RankMaster
                </TextBlock>
                <TextBlock Text="2" Foreground="#A1A1AA" TextAlignment="Center" Margin="0,0,0,28"/>

                <Button Style="{StaticResource StartButton}" Click="OnOpenFolder" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8B7;" Foreground="#60A5FA"
                                   FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Select Folder [O]" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ResumeButton" Style="{StaticResource ResumeButton}" Click="OnResume"
                        Visibility="Collapsed" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Resume Session" TextAlignment="Center"/>
                        <TextBlock x:Name="ResumeHint" FontSize="10" Foreground="#60A5FA"
                                   TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RenameButton" Style="{StaticResource RenameButton}" Click="OnRename"
                        Visibility="Collapsed" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8A5;" FontSize="20"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Rename Files by Rank" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border x:Name="StartErrorBox" Visibility="Collapsed" Background="#1AEF4444"
                        BorderBrush="#80EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                    <TextBlock x:Name="StartError" Foreground="#F87171" TextWrapping="Wrap" FontSize="13"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Compare -->
        <Grid x:Name="RankPanel" Visibility="Collapsed" Background="#000000" SizeChanged="OnRankSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftPane" Grid.Column="0" Background="#000000"
                  MouseLeftButtonDown="OnLeftClick" Cursor="Hand"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="LeftScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Image x:Name="LeftImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <MediaElement x:Name="LeftVideo" Stretch="Uniform" Volume="0" IsMuted="True"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              MediaEnded="OnVideoEnded" MediaOpened="OnVideoOpened"
                              MediaFailed="OnMediaFailed"/>
                <Border x:Name="LeftFlash" Background="White" Opacity="0" IsHitTestVisible="False"/>
                <Border x:Name="LeftRing" BorderBrush="#34D399" BorderThickness="5" Opacity="0" IsHitTestVisible="False"/>
                <TextBlock x:Name="LeftSpinner" FontFamily="{StaticResource Icons}" Text="&#xE895;"
                           FontSize="40" Foreground="#6B7280"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="LeftName" Margin="280,18,16,0" VerticalAlignment="Top"
                           HorizontalAlignment="Left" FontSize="11" Foreground="#66FFFFFF"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
            </Grid>

            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#111827"
                    IsHitTestVisible="False"/>

            <Grid x:Name="RightPane" Grid.Column="1" Background="#000000"
                  MouseLeftButtonDown="OnRightClick" Cursor="Hand"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="RightScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Image x:Name="RightImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <MediaElement x:Name="RightVideo" Stretch="Uniform" Volume="0" IsMuted="True"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              MediaEnded="OnVideoEnded" MediaOpened="OnVideoOpened"
                              MediaFailed="OnMediaFailed"/>
                <Border x:Name="RightFlash" Background="White" Opacity="0" IsHitTestVisible="False"/>
                <Border x:Name="RightRing" BorderBrush="#34D399" BorderThickness="5" Opacity="0" IsHitTestVisible="False"/>
                <TextBlock x:Name="RightSpinner" FontFamily="{StaticResource Icons}" Text="&#xE895;"
                           FontSize="40" Foreground="#6B7280"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="RightName" Margin="16,18,64,0" VerticalAlignment="Top"
                           HorizontalAlignment="Right" FontSize="11" Foreground="#66FFFFFF"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Action bar: [1][4]  ……  [5][2]  top center, same as RankMaster -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                        IsHitTestVisible="True">
                <StackPanel Orientation="Horizontal" Margin="0,0,64,0">
                    <StackPanel Margin="0,0,12,0">
                        <Button Style="{StaticResource IconCircle}" Click="OnDiscardLeft" ToolTip="Discard left">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74D;" FontSize="20"/>
                        </Button>
                        <TextBlock Text="[1]" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                   Foreground="#4DFFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource IconCircle}" Click="OnSpecialLeft" ToolTip="Special 1, left">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE734;" FontSize="20"/>
                        </Button>
                        <TextBlock Text="[4]" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                   Foreground="#4DFFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="64,0,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <Button Style="{StaticResource IconCircle}" Click="OnSpecialRight" ToolTip="Special 1, right">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE734;" FontSize="20"/>
                        </Button>
                        <TextBlock Text="[5]" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                   Foreground="#4DFFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource IconCircle}" Click="OnDiscardRight" ToolTip="Discard right">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74D;" FontSize="20"/>
                        </Button>
                        <TextBlock Text="[2]" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                   Foreground="#4DFFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Left info card: top-4 left-4, w-64 -->
            <Border Grid.Column="0" Width="256" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16,16,0,0" Background="#99000000" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="12" IsHitTestVisible="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8B7;" Foreground="#60A5FA"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="OverlayFolder" FontWeight="Bold" Foreground="White" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" x:Name="OverlayConfidencePct"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#60A5FA"/>
                        <TextBlock Text="CONFIDENCE" FontSize="10" FontWeight="Bold"
                                   Foreground="#71717A" VerticalAlignment="Bottom"/>
                    </DockPanel>
                    <Grid Height="6" Margin="0,0,0,12">
                        <Border Background="#0DFFFFFF" CornerRadius="3"/>
                        <Border x:Name="ConfidenceFill" HorizontalAlignment="Left" Width="0"
                                Background="#60A5FA" CornerRadius="3"/>
                    </Grid>
                    <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="UNRANKED" FontSize="10" Foreground="#71717A"/>
                                <TextBlock x:Name="OverlayUnranked" FontFamily="Consolas" FontSize="14"
                                           Foreground="#FB923C"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SESSION" FontSize="10" Foreground="#71717A"/>
                                <TextBlock x:Name="OverlaySession" FontFamily="Consolas" FontSize="14"
                                           Foreground="#93C5FD"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Help: top-4 right-4 -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,16,16,0" IsHitTestVisible="True"
                        MouseEnter="OnHelpEnter" MouseLeave="OnHelpLeave">
                <Border x:Name="HelpButton" Width="36" Height="36" CornerRadius="18"
                        Background="#99000000" BorderBrush="#1AFFFFFF" BorderThickness="1"
                        Cursor="Help">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE897;" FontSize="16"
                               Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="HelpPanel" Width="208" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="#CC000000" BorderBrush="#1AFFFFFF" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE765;" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Controls" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/><RowDefinition Height="22"/>
                                <RowDefinition Height="22"/><RowDefinition Height="22"/>
                                <RowDefinition Height="22"/><RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Foreground="#9CA3AF" Text="Select Left"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="Consolas" Text="[←]"/>
                            <TextBlock Grid.Row="1" Foreground="#9CA3AF" Text="Select Right"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Text="[→]"/>
                            <TextBlock Grid.Row="2" Foreground="#9CA3AF" Text="Skip"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" Text="[↓]/[S]"/>
                            <TextBlock Grid.Row="3" Foreground="#9CA3AF" Text="Discard"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Consolas" Text="[1] / [2]"/>
                            <TextBlock Grid.Row="4" Foreground="#9CA3AF" Text="Special"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Consolas" Text="[4] / [5]"/>
                            <TextBlock Grid.Row="5" Foreground="#9CA3AF" Text="Open"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" FontFamily="Consolas" Text="[O]"/>
                            <TextBlock Grid.Row="6" Foreground="#9CA3AF" Text="Exit"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" FontFamily="Consolas" Text="[Esc]"/>
                        </Grid>
                        <TextBlock Text="RankMaster 2" FontFamily="Consolas" FontSize="10"
                                   Foreground="#52525B" TextAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

        <Grid x:Name="RenamePanel" Visibility="Collapsed" Background="#E0000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Renaming" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RenameStatus" Margin="0,16,0,0" Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"
                Background="#CC18181B" BorderBrush="#33FFFFFF" BorderThickness="1"
                CornerRadius="20" Padding="20,10" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="14" Foreground="White"/>
        </Border>
    </Grid>
</Window>
