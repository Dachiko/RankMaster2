<Window x:Class="RankMaster2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rank Master 2"
        Background="#000000"
        Foreground="#EEEEEE"
        Width="1100"
        Height="720"
        MinWidth="800"
        MinHeight="500">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Rank Master 2" Margin="0,0,0,12"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,24"
                       Text="Compare two files in a folder. Rankings are stored in rankmaster_db.json next to the media. The compare loop is not wired yet — see SPEC.md."/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.6"/>
        </StackPanel>
    </Grid>
</Window>
