<Project>
  <PropertyGroup>
    <!-- Bump after every shipped change. Patch = tiny fix. Minor = new capability.
         Major = large feature or engine rewrite.

         3.0.0 is Rank Master 3: the server, the phone client and the new Windows client. Rank
         Master 2 is the WPF desktop app the owner runs today, which stays at 1.1.4 and pins its
         own name and version in src/RankMaster2.App - it is the program being replaced, not a
         member of this release. One number across the three new pieces, so "which server, which
         phone, which client" is one question and not three. -->
    <Version>3.0.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Rank Master 3</Product>
    <AssemblyTitle>Rank Master 3</AssemblyTitle>
  </PropertyGroup>
</Project>
