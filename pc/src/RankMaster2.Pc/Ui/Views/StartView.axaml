<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RankMaster2.Pc.Ui.Views"
             x:Class="RankMaster2.Pc.Ui.Views.StartView">
  <!-- Plan H § 3.1 (mockup C, frames 01-04): no card, no gradient. The last folder is the screen. -->
  <Grid Background="{DynamicResource House.Bg}">

    <!-- Corner captions, 26 px from the top and 34 px from the sides. -->
    <Grid Margin="34,26,34,0" VerticalAlignment="Top">
      <TextBlock Classes="caps" Text="RANK MASTER 3" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Ellipse Name="ServerDot" Classes="sd" Margin="0,0,7,0" />
        <TextBlock Name="ServerText" Classes="caps faint" Text="SERVER" />
        <TextBlock Name="KeysCaption" Classes="caps faint" Text="  ·  F1 KEYS" />
      </StackPanel>
    </Grid>

    <!-- The centre column. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14" MinHeight="14" Spacing="7">
        <Ellipse Name="LabelDot" Classes="sd live" IsVisible="False" />
        <TextBlock Name="LabelText" Classes="caps" VerticalAlignment="Center" />
      </StackPanel>

      <!-- The hero shrinks to fit rather than overflow when a folder's name is very long. -->
      <Viewbox Name="HeroBox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
        <TextBlock Name="HeroText" Classes="dot" FontSize="64" />
      </Viewbox>

      <!-- Under the hero: the folder's path, or (while a folder opens) the busy line instead of it. -->
      <Grid Name="UnderRow" HorizontalAlignment="Center" Margin="0,10,0,0" MinHeight="16">
        <TextBlock Name="PathText" FontSize="12.5" Foreground="{DynamicResource House.Faint}"
                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
        <views:BusyLine Name="Busy" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                        TrackBrush="{DynamicResource House.Line}" DashBrush="{DynamicResource House.Accent}" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,34,0,0">
        <Button Name="ResumeButton" Classes="pill" IsVisible="False"
                ToolTip.Tip="Continue ranking the folder you had open last time">
          <TextBlock Name="ResumeText" FontSize="10.5" FontWeight="Medium" LetterSpacing="1.68" />
        </Button>
        <Button Name="OpenButton" Classes="pill"
                ToolTip.Tip="Pick a folder of photos or videos and start ranking them by pairwise comparison">
          <TextBlock Text="O OPEN" FontSize="10.5" FontWeight="Medium" LetterSpacing="1.68" />
        </Button>
        <Button Name="RenameButton" Classes="pill"
                ToolTip.Tip="Rename every file in a folder to match its current rank, without opening it to rank">
          <TextBlock Text="R RENAME" FontSize="10.5" FontWeight="Medium" LetterSpacing="1.68" />
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- Bottom centre, 34 px up: the status line. -->
    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34">
      <Ellipse Name="StatusDot" Classes="sd" IsVisible="False" />
      <TextBlock Name="StatusLine" Classes="mid" FontSize="12" MinHeight="18" />
    </StackPanel>

    <views:KeysPage Name="Keys" />
  </Grid>
</UserControl>
