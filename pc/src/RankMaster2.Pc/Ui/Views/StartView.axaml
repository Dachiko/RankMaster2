<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RankMaster2.Pc.Ui.Views"
             x:Class="RankMaster2.Pc.Ui.Views.StartView">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#18181B" Offset="0" />
        <GradientStop Color="#000000" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
        <TextBlock Text="Rank Master 3" FontSize="48" FontWeight="Black">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Color="#60A5FA" Offset="0" />
              <GradientStop Color="#34D399" Offset="1" />
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>
        <TextBlock Name="VersionText" FontSize="12" Foreground="{DynamicResource VersionText}" VerticalAlignment="Top" />
      </StackPanel>
    </StackPanel>

    <StackPanel Width="512" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <Button Name="OpenButton" Content="Select Folder  [O]" HorizontalContentAlignment="Center" Height="52" FontSize="18" FontWeight="SemiBold"
              Background="{DynamicResource StartButtonFill}" BorderBrush="{DynamicResource StartButtonBorder}" BorderThickness="1"
              CornerRadius="12" />

      <Button Name="ResumeButton" HorizontalContentAlignment="Center" Height="52" FontSize="18" FontWeight="SemiBold"
              Background="{DynamicResource ResumeButtonFill}" BorderBrush="{DynamicResource ResumeButtonBorder}" BorderThickness="1"
              CornerRadius="12" IsVisible="False" />

      <TextBlock Name="OpeningLine" Foreground="{DynamicResource VersionText}" HorizontalAlignment="Center" IsVisible="False" FontSize="13" />

      <Border Name="ErrorBox" Background="{DynamicResource ErrorBoxFill}" BorderBrush="{DynamicResource ErrorBoxBorder}" BorderThickness="1"
              CornerRadius="8" Padding="16" IsVisible="False">
        <TextBlock Name="ErrorText" Foreground="{DynamicResource ErrorBoxText}" FontSize="13" TextWrapping="Wrap" />
      </Border>

      <TextBlock Name="StatusLine" Foreground="{DynamicResource VersionText}" HorizontalAlignment="Center" FontSize="12" IsVisible="False" />
    </StackPanel>

    <Border Name="HelpButton" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,16,16,0" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
      <Path Data="{DynamicResource Icon.Help}" Stretch="Uniform" Width="18" Height="18" Stroke="White" StrokeThickness="1.5" />
    </Border>
    <views:HelpSheet Name="Help" />
  </Grid>
</UserControl>
