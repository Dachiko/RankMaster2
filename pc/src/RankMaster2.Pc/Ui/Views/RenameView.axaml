<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RankMaster2.Pc.Ui.Views"
             x:Class="RankMaster2.Pc.Ui.Views.RenameView"
             Focusable="False">
  <!-- Plan H § 3.2 (mockup C, frames 05-06): the start screen stays drawn underneath (UiRoot puts this
       view over it); this grid is the veil, `bg` at 78 %, and the ink card sits in its centre. The veil is
       hit-testable on purpose: a click outside the card must not reach the start screen under it. -->
  <Grid Background="{DynamicResource House.Veil}">
    <Border Name="Card" Classes="inkcard" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
      <Grid>
        <views:DotGrid Brush="{DynamicResource House.InkGrid}" />

        <StackPanel Margin="30,22,30,18">

          <!-- Confirming: the question. -->
          <StackPanel Name="ConfirmPanel">
            <TextBlock Classes="caps accent" Text="RENAME BY RANK" />
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxWidth="500" Margin="0,16,0,8">
              <TextBlock Name="ConfirmFolder" Classes="dot" FontSize="56" Foreground="{DynamicResource House.OnInk}" />
            </Viewbox>
            <TextBlock Name="ConfirmLine" FontSize="13.5" Foreground="{DynamicResource House.OnInk75}" TextTrimming="CharacterEllipsis" />
            <views:DottedRule Margin="0,18,0,10" Brush="{DynamicResource House.Mid}" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Name="YesCaption" Classes="caps onink" Text="ENTER RENAME" />
              <TextBlock Classes="caps onink60" Text="  ·  " />
              <TextBlock Name="NoCaption" Classes="caps onink" Text="ESC KEEP" />
            </StackPanel>
          </StackPanel>

          <!-- Running: the percent and the dots. Never "done / total" (plan H § 3.2). -->
          <StackPanel Name="RunningPanel" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Classes="sd live pulse" />
              <TextBlock Classes="caps onink" Text="RENAMING" />
              <TextBlock Name="RunningFolder" Classes="caps onink60" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
              <TextBlock Name="PercentText" Classes="dot" FontSize="56" Foreground="{DynamicResource House.OnInk}" />
              <TextBlock Text="%" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource House.OnInk}"
                         VerticalAlignment="Bottom" Margin="6,0,0,6" />
            </StackPanel>
            <Grid Height="14" Margin="0,4,0,4">
              <views:DotRow Name="Dots" VerticalAlignment="Center"
                            OnBrush="{DynamicResource House.Accent}" OffBrush="{DynamicResource House.DotOff}" />
              <views:BusyLine Name="CancellingLine" IsVisible="False" VerticalAlignment="Center"
                              TrackBrush="{DynamicResource House.Rule}" DashBrush="{DynamicResource House.Accent}" />
            </Grid>
            <views:DottedRule Margin="0,12,0,10" Brush="{DynamicResource House.Mid}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Name="CancelCaption" Grid.Column="0" Classes="caps onink" Text="ESC CANCEL" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Name="PhasePrepare" Classes="caps onink60" Text="PREPARE" />
                <TextBlock Classes="caps onink60" Text=" · " />
                <TextBlock Name="PhaseRename" Classes="caps onink60" Text="RENAME" />
                <TextBlock Classes="caps onink60" Text=" · " />
                <TextBlock Name="PhaseSave" Classes="caps onink60" Text="SAVE" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
