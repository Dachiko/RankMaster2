<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RankMaster2.Pc.Ui.Views"
             x:Class="RankMaster2.Pc.Ui.Views.BrowseView">
  <!-- Plan I § 2.2 (mockup F, "5 · Folders"): the full path on top, the folder names under it, nothing else. -->
  <Grid Background="{DynamicResource House.Bg}">

    <!-- Corner captions, as on the start screen: 26 px from the top, 34 px from the sides. -->
    <Grid Margin="34,26,34,0" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <TextBlock Classes="caps" Text="RANK MASTER 3 / " />
        <TextBlock Name="ModeText" Classes="caps" Text="OPEN" />
      </StackPanel>
      <TextBlock Name="KeysCaption" Classes="caps faint" Text="F1 KEYS" HorizontalAlignment="Right" />
    </Grid>

    <!-- The column: 760 wide, 130 px from the top. -->
    <Grid Name="Column" MaxWidth="760" HorizontalAlignment="Stretch" Margin="34,130,34,96" RowDefinitions="Auto,Auto,*">
      <!-- The path line, and the letters typed after it. -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" MinHeight="56" VerticalAlignment="Top">
        <StackPanel Name="PathPanel" Orientation="Horizontal" />
        <StackPanel Name="TypedPanel" Orientation="Horizontal" Margin="26,0,0,0" VerticalAlignment="Center" IsVisible="False">
          <TextBlock Name="TypedText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource House.Accent}" />
          <Rectangle Classes="caret" Width="1.5" Height="20" Margin="2,0,0,0" />
        </StackPanel>
      </StackPanel>

      <!-- DESIGN.md "busy line": it always takes its 2 px, so nothing moves when it starts or stops. Only as wide as
           the path line. -->
      <Border Grid.Row="1" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left">
        <views:BusyLine Name="Busy" IsVisible="False"
                        TrackBrush="{DynamicResource House.Line}" DashBrush="{DynamicResource House.Accent}" />
      </Border>

      <!-- The rows. Their text lines up with the path's: the list starts 12 px left of the column. -->
      <Grid Grid.Row="2" Margin="-12,26,0,0">
        <views:BrowseList Name="RowList"
                          InkBrush="{DynamicResource House.Ink}" OnInkBrush="{DynamicResource House.OnInk}"
                          PaperBrush="{DynamicResource House.Paper}" AccentBrush="{DynamicResource House.Accent}" />
        <TextBlock Name="EmptyLine" Classes="caps faint" Text="NO FOLDERS INSIDE" Margin="12,12,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="False" />
      </Grid>
    </Grid>

    <!-- Bottom centre, 34 px up: the accent status line (it keeps its height), then the faint key line. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34" Spacing="10">
      <TextBlock Name="StatusLine" Classes="accent" FontSize="12" MinHeight="18" HorizontalAlignment="Center" />
      <TextBlock Name="KeyLine" Classes="caps faint" HorizontalAlignment="Center" />
    </StackPanel>

    <views:KeysPage Name="Keys" />
  </Grid>
</UserControl>
